# Copy to .env for local development. Never commit .env.
#
# When using docker compose, only the Stripe vars below need to be set — the
# database, port, and CORS values are hard-coded in docker-compose.yml so they
# work out of the box.

# HTTP server (used when running with `make run` outside docker)
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated list of allowed frontend origins. Use "*" only for throwaway
# environments. Example for Railway dev: include both the deployed frontend
# AND localhost so you can hit dev backend from your laptop too.
#   CORS_ALLOWED_ORIGIN=https://pagasa-centre-website-dev.up.railway.app,http://localhost:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Postgres (used when running with `make run` outside docker)
DATABASE_URL=postgres://pagasa:pagasa@localhost:5432/pagasa?sslmode=disable

# Host-side port remaps for `make docker-up`. Uncomment + change if these
# defaults collide with something else running on your machine.
# POSTGRES_HOST_PORT=55432
# API_HOST_PORT=8081

# Stripe (use test-mode keys locally; required for `make run` AND `make docker-up`)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/camp/registration/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/camp/registration/cancelled

# Google Sheets live sync (optional). Append a row to a configured Sheet on
# every paid registration. Leave any of these blank to disable. The JSON value
# should be base64-encoded (paste the contents of the service-account key file
# through `base64 -i path/to/key.json | tr -d '\n'`).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_PENDING_TAB=Pending
GOOGLE_SHEETS_PAID_TAB=Paid

# Email (optional in dev — leave SMTP_HOST blank to log instead of sending).
# For Gmail / Google Workspace: enable 2FA on the account, then create an
# app password at https://myaccount.google.com/apppasswords. SMTP_USERNAME is
# the full email address, SMTP_PASSWORD is the 16-char app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=pagasacentre@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM="PC Summer Camp 2026 <pagasacentre@gmail.com>"

# Resend (preferred on Railway — SMTP ports are often blocked)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="PC Summer Camp 2026 <onboarding@resend.dev>"

# Admin dashboard (White Team) — shared password + random session secret
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
ADMIN_SECURE_COOKIE=0
# Separate password for generating free-place codes (church-funded registrations)
ADMIN_FREE_CODE_PASSWORD=
WHITE_TEAM_EMAIL=white-team@example.com
INVOICE_DUE_DAYS=15

# Stripe Price IDs for balance invoices (from Stripe Dashboard → Products).
# Catalog prices already net out the £50 deposit.
STRIPE_PRICE_LODGE=price_xxx
STRIPE_PRICE_CABIN=price_xxx
STRIPE_PRICE_STATIC_CARAVAN=price_xxx
STRIPE_PRICE_POD=price_xxx
STRIPE_PRICE_TENT=price_xxx
STRIPE_PRICE_CHILD_3_12=price_xxx
STRIPE_PRICE_CHILD_UNDER3=price_xxx
